# API Keys
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...
HUGGINGFACE_API_KEY=hf_...
PINECONE_API_KEY=...
PERSPECTIVE_API_KEY=...

# Social Media APIs
TWITTER_BEARER_TOKEN=...
TWITTER_API_KEY=...
TWITTER_API_SECRET=...
INSTAGRAM_USERNAME=...
INSTAGRAM_PASSWORD=...
FACEBOOK_APP_ID=...
FACEBOOK_APP_SECRET=...

# Database Configuration
POSTGRES_PASSWORD=your_secure_password
POSTGRES_URL=postgresql://mlops:your_secure_password@localhost:5432/ml_pipeline

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# RabbitMQ Configuration
RABBITMQ_PASSWORD=your_secure_password
RABBITMQ_URL=amqp://admin:your_secure_password@localhost:5672//

# Storage Configuration (AWS)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
S3_BUCKET=ml-pipeline-data

# Storage Configuration (GCP - alternative)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
GCS_BUCKET=ml-pipeline-data

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=https://s3.amazonaws.com

# Vector Database Configuration
QDRANT_URL=http://localhost:6333
# Or use Pinecone (set PINECONE_API_KEY above)
PINECONE_ENVIRONMENT=us-east-1

# Authentication
JWT_SECRET_KEY=your-secret-key-min-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Monitoring & Logging
SENTRY_DSN=https://...@sentry.io/...
DATADOG_API_KEY=...
GRAFANA_PASSWORD=admin

# Application Configuration
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=INFO
DEBUG=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Cost Management
MONTHLY_BUDGET_LIMIT=10000  # USD
COST_ALERT_THRESHOLD=0.8

# Feature Flags
ENABLE_BATCH_PROCESSING=true
ENABLE_STREAMING=false
ENABLE_GPU=true
ENABLE_AB_TESTING=true
ENABLE_CONTENT_MODERATION=true

# Model Configuration
PRIMARY_EMBEDDING_PROVIDER=local  # local, openai
PRIMARY_LLM_PROVIDER=anthropic  # anthropic, openai, local
PRIMARY_IMAGE_PROVIDER=openai  # openai, local

# Cache Configuration
CACHE_TTL_EMBEDDINGS=86400  # 24 hours
CACHE_TTL_PERSONAS=604800  # 7 days
CACHE_TTL_ADS=86400  # 24 hours

# Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://mlops:your_secure_password@postgres:5432/ml_pipeline
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here
AIRFLOW__WEBSERVER__SECRET_KEY=your-secret-key-here

# Vault Configuration (optional)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=...

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL=alerts@yourcompany.com
